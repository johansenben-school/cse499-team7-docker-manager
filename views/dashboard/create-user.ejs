<div class="profile-container">
    <h2>Create New Admin User</h2>

    <% if (locals.error) { %>
        <div style="color: #721c24; background-color: #f8d7da; border: 1px solid #f5c6cb; padding: 12px; margin-bottom: 20px; border-radius: 6px; font-weight: 500; font-size: 14px;">
            <%= error %>
        </div>
    <% } %>

    <form action="/create-user" method="POST" class="profile-form" novalidate>
        <div class="form-group">
            <label for="username">New Username</label>
            <input type="text" id="username" name="username">
        </div>
        <div class="form-group">
            <label for="password">Initial Password</label>
            <input type="password" id="password" name="password">
        </div>
        <div class="form-group">
            <label>
                <input type="checkbox" name="isAdmin" value="true">
                Grant Administrative Access
            </label>
        </div>
        <button type="submit" class="btn btn-primary">Create User</button>
    </form>
</div>