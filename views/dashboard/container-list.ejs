<style>
  main {
    flex: 1
  }
  .container-block {
    display: grid;
    grid-template-columns: 100%;
    background: var(--card-bg);
    margin-block: 0.5rem;
    padding: 0.5em;
    border: 1px solid var(--primary-blue);
  }
  .container-summary {
    grid-row: 1;
    font-size: large;
    display: flex;
    justify-content: space-between;
  }
  .container-details {
    grid-row: 2;
    display: none;
  }
  .container-expand-details {
    grid-row: 3;
    width: 100%;
    height: 1rem;
    cursor: pointer;
  }
  .container-expand-details:hover {
    scale: 1.05;
    transform-origin: left;
  }
  .container-expand-details::after {
    content: 'see more';
    font-style: italic;
    opacity: 0.8;
  }
  .container-expand-details:has(input:checked)::after {
    content: 'see less';
    font-style: italic;
    opacity: 0.8;
  }
  .container-expand-details:has(input:checked) + .container-details {
    display: grid;
  }
  .container-expand-details input {
    display: none;
  }
  .container-controls {
    display: flex;
    gap: 0.5em;
    margin-left: auto;
  }
  .container-control {
    width: 2em;
    height: 2em;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .container-control:not(.disabled-control):hover {
    scale: 1.1;
    cursor: pointer;
  }
  .start-container {
    background: green;
  }
  .start-container::after {
    content: '';
    display: block;
    border-left: 1em white solid;
    border-top: 0.5em transparent solid;
    border-bottom: 0.5em transparent solid;
  }
  .stop-container {
    background: orange;
  }
  .stop-container::after {
    content: '';
    display: block;
    width: 1em;
    height: 1em;
    background: white;
  }
  .delete-container {
    background: red;
  }
  .delete-container::after {
    content: '✕';
    font-size: 1.5em;
    font-weight: bolder;
    color: white
  }
  .disabled-control {
    background: gray;
  }
  a {
    font-style: none;
    text-decoration: none;
    color: inherit;
  }
  .detail-label {
    font-weight: bold;
    font-size: large;
    margin-right: 0.5rem;
  }
  .container-name:hover {
    scale: 1.05;
    transform-origin: left;
  }
</style>
<script>
  const containerControl = async (type, id, setStatus) => {
    await fetch("/container/" + type + "/" + id, {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            id
        })
    });
    window.location.reload();
  } 
</script>
<h2>Containers</h2>
<% containers.forEach(c => { %>
  <div class="container-block">
    <div class="container-summary">
      <a href="/container/<%= c.Id %>" class="container-name"><%= c.Names[0].substring(1) %></a>
      <span class="container-controls">
        <div onclick="containerControl('start', '<%= c.Id %>')" class="container-control start-container <%= !user.isAdmin || c.State === "running" ? "disabled-control" : '' %>"></div>
        <div onclick="containerControl('stop', '<%= c.Id %>')" class="container-control stop-container <%= !user.isAdmin || c.State !== "running" ? "disabled-control": '' %>"></div>
        <div onclick="containerControl('delete', '<%= c.Id %>')" class="container-control delete-container <%= user.isAdmin ? '' : "disabled-control" %>"></div>
      </span>
    </div>
    <label class="container-expand-details">
      <input type="checkbox" name="expand-details">
    </label>
    <div class="container-details">
      <span><span class="detail-label">ID:</span><%= c.Id %></span>
      <span><span class="detail-label">Image:</span><%= c.Image %></span>
      <span><span class="detail-label">Image ID:</span><%= c.ImageID %></span>
      <!-- <br>
      <span><%= JSON.stringify(c) %></span> -->
    </div>
  </div>
<% }) %>